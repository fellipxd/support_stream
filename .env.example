# --- Core -------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_stream?schema=public"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Secrets (32+ chars; generate with: openssl rand -base64 48) ------------
SESSION_SECRET="dev-session-secret-change-me-in-production-0000000"
ATTACHMENT_SECRET="dev-attachment-secret-change-me-in-production-0000"

# --- Email ------------------------------------------------------------------
MAIL_DRIVER="console"          # console | smtp
MAIL_FROM="Support Portal <support@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# --- Storage ----------------------------------------------------------------
STORAGE_DRIVER="local"         # local | s3
STORAGE_LOCAL_PATH="./storage"

# --- Guest access & limits --------------------------------------------------
GUEST_TOKEN_TTL_DAYS="30"
GUEST_SESSION_TTL_HOURS="24"
REOPEN_WINDOW_DAYS="14"
AUTO_CLOSE_DAYS="7"
MAX_ATTACHMENT_MB="25"
MAX_ATTACHMENTS_PER_TICKET="10"

# --- Abuse protection -------------------------------------------------------
CAPTCHA_PROVIDER="none"        # none | turnstile
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
GUEST_SUBMISSIONS_PER_HOUR="5"

# --- Jobs -------------------------------------------------------------------
JOB_RUNNER_SECRET="dev-job-runner-secret-change-me"
